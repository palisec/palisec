{
  "name": "policy-enforced-accounts",
  "version": "0.2.0",
  "description": "Read policy-enforced agent accounts and verify signed decision receipts (draft ERC: Policy-Enforced Agent Accounts). No API key: the chain and the spec only.",
  "license": "CC0-1.0",
  "homepage": "https://palisec.tech/docs/standard",
  "keywords": [
    "erc",
    "policy",
    "ai-agents",
    "smart-accounts",
    "erc-165",
    "eip-712",
    "safe",
    "erc-4337"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "vectors",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vectors": "node scripts/make-vectors.mjs"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5",
    "viem": "2.57.19",
    "vitest": "^5",
    "@types/node": "^22"
  }
}
