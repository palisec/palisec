# Copy to .env.local for local development. Never commit real values.

# Postgres (Neon). Pooled connection string for the app.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Direct (non-pooled) connection, used only by migrations at server start. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Canonical public URL. Sign-in messages are bound to this host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Disable Next.js telemetry (also lets an idle Railway service sleep).
NEXT_TELEMETRY_DISABLED=1
# Extra hostnames allowed to issue sign-in messages, comma-separated.
PALISEC_EXTRA_HOSTS=

# Optional: a private Robinhood Chain testnet RPC (e.g. Alchemy). Public RPC is used otherwise.
RH_TESTNET_RPC_URL=
