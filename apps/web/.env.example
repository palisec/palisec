# Copy to .env.local for local development. Never commit real values.

# Postgres. A *.neon.tech URL uses Neon's HTTPS driver; anything else uses a normal connection.
# In production this is a GoDaddy hosting secret, never a file.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Direct connection for migrations, if DATABASE_URL goes through a pooler.
DATABASE_URL_UNPOOLED=

# Optional. Defaults to https://palisec.tech in production and localhost in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Disable Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
# Extra hostnames allowed to issue sign-in messages, comma-separated.
PALISEC_EXTRA_HOSTS=

# Optional: a private Robinhood Chain testnet RPC (e.g. Alchemy). Public RPC is used otherwise.
RH_TESTNET_RPC_URL=
