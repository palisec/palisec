{
  "name": "@palisec/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @palisec/sdk pack:web && node scripts/migrate.mjs && next build",
    "db:migrate": "node scripts/migrate.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --no-warnings --test test/health-status.test.ts test/browser-wallet.test.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@neondatabase/serverless": "1.2.0",
    "@palisec/policy-engine": "workspace:*",
    "@palisec/policy-schema": "workspace:*",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "viem": "2.57.19",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
